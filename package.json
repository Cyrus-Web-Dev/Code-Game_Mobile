{
  "name": "kode-tebak-mobile",
  "version": "2.5.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsx scripts/test-engine.ts",
    "data": "python3 scripts/sql_to_json.py ../kode-tebak/supabase/seed src/data/q",
    "setup": "expo install react-native-svg react-native-screens react-native-safe-area-context @react-native-async-storage/async-storage @expo/vector-icons expo-font expo-haptics expo-image-picker expo-linear-gradient expo-splash-screen expo-status-bar && expo install --fix",
    "fix": "node scripts/doctor.mjs",
    "clean": "expo start -c",
    "check": "npm run typecheck && npm run test:engine",
    "start:fast": "expo start -c --no-dev --minify"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/space-grotesk": "^0.2.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.16",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
